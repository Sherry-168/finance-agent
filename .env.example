# 复制为 .env 后填写真实值：Windows `copy .env.example .env`，Linux/macOS `cp .env.example .env`
# .env 已被 .gitignore 忽略，任何真实密钥都不得提交到仓库。

# ---------------------------------------------------------------- LLM
# 解析后端二选一（第二周新增，验收项「LLM 调用可切 Dify」）：
#   openai = 直连 OpenAI 兼容接口（DeepSeek / Qwen / GLM），改下面三行即可换供应商
#   dify   = 走 Dify 工作流（李语琛交付，多模态拆单 + 追问 + 越界拒绝都在工作流里）
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_TIMEOUT=30

# ---------------------------------------------------------------- Dify 工作流
# LLM_PROVIDER=dify 时必填；Key 在 Dify「应用 → API 访问」页拿（app- 开头）
# 忘记填 Key 时后端会自动回退 openai，不会启动失败
DIFY_API_KEY=
DIFY_BASE_URL=https://api.dify.ai/v1
# 工作流「开始节点」里接收用户输入的变量名，与编排页保持一致
DIFY_INPUT_KEY=user_input
DIFY_USER=demo_user
DIFY_TIMEOUT=30
# 多模态工作流里接收图片（base64 data URL）的变量名
DIFY_IMAGE_KEY=receipt_image

# ---------------------------------------------------------------- 语音识别（ASR）
# 红线：**禁止在镜像里跑本地语音模型**，语音转文字一律走云端 API。
#   auto  = 配了 ASR_API_KEY 就调云端 /audio/transcriptions；没配则语音接口明确报 2003
#   agent = 调用李语琛的 agent.speech_to_text(audio_path)
#   mock  = 离线演示，不联网直接返回 ASR_MOCK_TEXT（响应里 asr_engine=mock 会如实标注）
ASR_PROVIDER=auto
ASR_API_KEY=
# 智谱（open.bigmodel.cn/api/paas/v4，glm-asr）或阿里云百炼 compatible-mode 均可
ASR_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ASR_MODEL=glm-asr
ASR_LANGUAGE=zh
ASR_TIMEOUT=30
ASR_MOCK_TEXT=昨天打车 32 块

# ---------------------------------------------------------------- OCR / 小票识别
# api   = 视觉模型（长截图可一次返回多笔，推荐）
# dify  = Dify 多模态工作流（配合 DIFY_IMAGE_KEY）
# local = 不打包本地 OCR 模型（镜像体积优先），此时 /records/ocr 返回 2002
OCR_PROVIDER=local
VISION_API_KEY=
VISION_BASE_URL=https://open.bigmodel.cn/api/paas/v4
VISION_MODEL=glm-4v-flash

# ---------------------------------------------------------------- 跨域与上传限制
# 逗号分隔；* 表示全部放开（评审机器直连 8000 最省事）
CORS_ORIGINS=*
MAX_UPLOAD_MB=10

# ---------------------------------------------------------------- 存储
# 相对路径按项目根目录解析；容器内由 docker-compose 覆盖为 /app/data/finance.db
DB_PATH=data/finance.db
DEFAULT_USER_ID=demo_user

# ---------------------------------------------------------------- 后端服务
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# ---------------------------------------------------------------- 前端（本地开发时指向本机后端）
# 容器内必须改为 http://backend:8000/api/v1，否则会指向容器自身的 localhost
API_BASE_URL=http://localhost:8000/api/v1
FRONTEND_HOST=0.0.0.0
FRONTEND_PORT=7860
